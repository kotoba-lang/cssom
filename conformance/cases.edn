 ;; ---------------------------------------------------------------------
 ;; Round twenty-one: the corpus grows 200 -> 292.
 ;;
 ;; Every case below is in territory the 200-case corpus did not reach.
 ;; They were chosen by INVENTORYING what was covered and picking what was
 ;; absent or thin -- not by picking markup the engine handles. Several are
 ;; expected to fail, and the aggregate percentages fall as a result; that
 ;; is the corpus doing its job rather than a regression.
 ;; ---------------------------------------------------------------------

 ;; --- containing blocks -------------------------------------------------
 ;; Every pre-existing `position: absolute` case gave the box a
 ;; `position: relative` PARENT, so the containing-block rules themselves
 ;; -- which ancestor, which box of it, what `auto` means on each side --
 ;; were never measured.

 {:id :position/absolute-with-no-positioned-ancestor
  :group :position
  ;; No positioned ancestor at all, so the containing block is the initial
  ;; one. Only `left` is set: `top: auto` keeps the STATIC position, which
  ;; is the part that stays well-defined however the case page is stacked.
  :html "<div><p>flow</p><span style=\"position: absolute; left: 40px\">abs</span></div>"}

 {:id :position/absolute-static-position-no-offsets
  :group :position
  ;; All four offsets `auto`: the box stays exactly where flow would have
  ;; put it, but is out of flow, so the sibling after it moves up.
  :html "<div style=\"position: relative\"><p>one</p><p style=\"position: absolute\">abs</p><p>two</p></div>"}

 {:id :position/absolute-left-and-right-set-width
  :group :position
  :html "<div style=\"position: relative; width: 300px; height: 40px\"><div style=\"position: absolute; left: 20px; right: 20px; top: 0\">stretched</div></div>"}

 {:id :position/absolute-top-and-bottom-set-height
  :group :position
  :html "<div style=\"position: relative; width: 200px; height: 100px\"><div style=\"position: absolute; top: 10px; bottom: 10px; left: 0\">tall</div></div>"}

 {:id :position/absolute-percentage-offsets
  :group :position
  :html "<div style=\"position: relative; width: 200px; height: 60px\"><div style=\"position: absolute; left: 50%; top: 50%\">half</div></div>"}

 {:id :position/absolute-percentage-width
  :group :position
  :html "<div style=\"position: relative; width: 200px; height: 40px\"><div style=\"position: absolute; left: 0; top: 0; width: 50%\">w</div></div>"}

 {:id :position/absolute-containing-block-is-the-padding-box
  :group :position
  ;; An absolutely positioned box resolves against its ancestor's PADDING
  ;; box, not its content box: `left: 0` sits just inside the border, with
  ;; the ancestor's 20px padding OUTSIDE it rather than indenting it.
  :html "<div style=\"position: relative; padding: 20px; border: 5px solid #000; width: 200px\"><div style=\"position: absolute; left: 0; top: 0\">corner</div><p>flow</p></div>"}

 {:id :position/absolute-nested-in-absolute
  :group :position
  ;; An absolutely positioned box is itself a containing block.
  :html "<div style=\"position: relative; width: 300px; height: 80px\"><div style=\"position: absolute; left: 40px; top: 10px; width: 200px; height: 60px\"><div style=\"position: absolute; left: 10px; top: 10px\">inner</div></div></div>"}

 {:id :position/relative-bottom-and-right
  :group :position
  ;; `bottom`/`right` shift in the opposite direction from `top`/`left`.
  :html "<div><div style=\"position: relative; bottom: 6px; right: 10px\">moved</div><div>after</div></div>"}

 {:id :position/relative-percentage-offset
  :group :position
  :html "<div style=\"width: 200px\"><div style=\"position: relative; left: 25%\">quarter</div></div>"}

 {:id :position/absolute-inside-a-flex-item
  :group :position
  :html "<div style=\"display: flex\"><div style=\"position: relative; width: 120px; height: 40px\"><div style=\"position: absolute; right: 0; top: 0\">tag</div></div><div>next</div></div>"}

 {:id :position/absolute-child-of-a-relative-inline
  :group :position
  ;; A relatively positioned INLINE is a containing block too.
  :html "<p>text <span style=\"position: relative\">anchor<span style=\"position: absolute; left: 0; top: 20px\">pop</span></span> tail</p>"}

