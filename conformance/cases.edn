 {:id :float/clear-both
  :group :float
  :html "<div style=\"width: 300px\"><div style=\"float: left; width: 60px; height: 30px\">L</div><div style=\"float: right; width: 60px; height: 50px\">R</div><div style=\"clear: both\">after</div></div>"}

 {:id :float/float-after-text-in-its-container
  :group :float
  ;; The documented v1 boundary: this engine places every float at the
  ;; container's top, so a float declared after a paragraph moves up past
  ;; it. A browser places it on the line it appears on.
  :html "<div style=\"width: 300px\"><p>leading text</p><div style=\"float: left; width: 60px; height: 30px\">F</div><p>beside the float</p></div>"}

 {:id :float/floats-that-do-not-fit-stack
  :group :float
  ;; The `overflow: hidden` wrapper is NOT the thing under test: it is there
  ;; because these floats extend BELOW their own container, and every case
  ;; on this page shares one document. Measured without it, the leaked float
  ;; pushed the next case's float from x=10 to x=130 -- a divergence charged
  ;; to the engine that the corpus itself had created.
  :html "<div style=\"overflow: hidden\"><div style=\"width: 200px\"><div style=\"float: left; width: 120px; height: 20px\">A</div><div style=\"float: left; width: 120px; height: 20px\">B</div><div>tail</div></div></div>"}

 {:id :float/float-with-margin
  :group :float
  ;; The `overflow: hidden` wrapper is containment, not the subject: the
  ;; float's 10px bottom MARGIN extends past its container, and measured
  ;; without the wrapper it narrowed the next case's first line and turned
  ;; a one-line paragraph into two.
  :html "<div style=\"overflow: hidden\"><div style=\"width: 300px\"><div style=\"float: left; width: 60px; height: 30px; margin: 10px\">F</div><div>text beside the float</div></div></div>"}

 {:id :float/float-right-block-with-width
  :group :float
  :html "<div style=\"width: 300px\"><div style=\"float: right; width: 80px; height: 30px\">R</div><p>alpha beta gamma delta</p></div>"}

 {:id :float/parent-does-not-contain-its-float
  :group :float
  ;; A float does not contribute to its parent's height: the browser
  ;; reports the inner 200px wrapper as 0 tall. The OUTER `overflow: hidden`
  ;; box is not under test -- it keeps the escaping float inside this case,
  ;; because every case shares one document. Measured without it, the next
  ;; case's BFC box was shifted 50px right by this float.
  :html "<div style=\"overflow: hidden\"><div style=\"width: 200px\"><div style=\"float: left; width: 50px; height: 60px\">F</div></div></div>"}

 {:id :float/overflow-hidden-contains-its-float
  :group :float
  ;; ...unless the parent establishes a block formatting context, which is
  ;; the entire reason authors write `overflow: hidden` on a wrapper.
  :html "<div style=\"width: 200px; overflow: hidden\"><div style=\"float: left; width: 50px; height: 60px\">F</div></div>"}

 ;; --- flexbox beyond the defaults ---------------------------------------

 {:id :flex/align-self-overrides-align-items
  :group :flex
  :html "<div style=\"display: flex; align-items: flex-start; height: 60px\"><div>a</div><div style=\"align-self: flex-end\">b</div><div style=\"align-self: center\">c</div></div>"}

 {:id :flex/order-reorders-items
  :group :flex
  :html "<div style=\"display: flex\"><div style=\"order: 2\">first</div><div style=\"order: 1\">second</div></div>"}

 {:id :flex/row-reverse
  :group :flex
  :html "<div style=\"display: flex; flex-direction: row-reverse; width: 300px\"><div>a</div><div>b</div><div>c</div></div>"}

 {:id :flex/column-reverse
  :group :flex
  :html "<div style=\"display: flex; flex-direction: column-reverse; height: 90px\"><div>a</div><div>b</div><div>c</div></div>"}

 {:id :flex/wrap-reverse
  :group :flex
  :html "<div style=\"display: flex; flex-wrap: wrap-reverse; width: 200px; height: 80px\"><div style=\"width: 120px\">a</div><div style=\"width: 120px\">b</div></div>"}

 {:id :flex/align-content-space-between
  :group :flex
  :html "<div style=\"display: flex; flex-wrap: wrap; align-content: space-between; width: 200px; height: 120px\"><div style=\"width: 120px\">a</div><div style=\"width: 120px\">b</div></div>"}

 {:id :flex/flex-shorthand-one
  :group :flex
  ;; `flex: 1` is `1 1 0%`, NOT `flex-grow: 1` -- the basis is zero, so the
  ;; items split the container evenly regardless of their content.
  :html "<div style=\"display: flex; width: 300px\"><div style=\"flex: 1\">a</div><div style=\"flex: 1\">bbbbbbbbbb</div></div>"}

 {:id :flex/inline-flex-in-a-sentence
  :group :flex
  :html "<p>before <span style=\"display: inline-flex; gap: 6px\"><span>a</span><span>b</span></span> after</p>"}

 {:id :flex/align-items-baseline
  :group :flex
  :html "<div style=\"display: flex; align-items: baseline\"><div style=\"font-size: 24px\">big</div><div>small</div></div>"}

 {:id :flex/auto-margin-pushes-item-right
  :group :flex
  :html "<div style=\"display: flex; width: 300px\"><div>left</div><div style=\"margin-left: auto\">right</div></div>"}

 {:id :flex/column-align-items-center
  :group :flex
  ;; In a column container the CROSS axis is horizontal.
  :html "<div style=\"display: flex; flex-direction: column; align-items: center; width: 200px\"><div>a</div><div>bbbb</div></div>"}

 {:id :flex/min-content-floor-on-an-item
  :group :flex
  ;; A flex item's automatic minimum size is its min-content width, so it
  ;; refuses to shrink below its longest unbreakable word.
  :html "<div style=\"display: flex; width: 120px\"><div style=\"flex: 1\">averylongunbrokenword</div><div style=\"flex: 1\">b</div></div>"}

 ;; --- grid flow and alignment -------------------------------------------

 {:id :grid/implicit-rows-from-overflow
  :group :grid
  ;; Four items in a 2-column grid with ONE explicit row: the second row is
  ;; implicit and auto-sized.
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; grid-template-rows: 30px\"><div>a</div><div>b</div><div>c</div><div>d</div></div>"}

 {:id :grid/auto-rows
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 60px; grid-auto-rows: 40px\"><div>a</div><div>b</div></div>"}

 {:id :grid/auto-flow-column
  :group :grid
  :html "<div style=\"display: grid; grid-auto-flow: column; grid-auto-columns: 70px\"><div>a</div><div>b</div><div>c</div></div>"}

 {:id :grid/row-span-two
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 70px 70px; grid-template-rows: 30px 30px\"><div style=\"grid-row: span 2\">tall</div><div>b</div><div>c</div></div>"}

 {:id :grid/explicit-row-placement
  :group :grid
  ;; `grid-row: 2` alone: the item is placed in row 2 and column
  ;; auto-placement still runs, so the two items are NOT on the same row.
  :html "<div style=\"display: grid; grid-template-columns: 70px 70px; grid-template-rows: 30px 30px\"><div style=\"grid-row: 2\">t</div><div>b</div></div>"}

 {:id :grid/line-number-placement
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px 60px\"><div style=\"grid-column: 1 / 3\">wide</div><div>b</div></div>"}

 {:id :grid/justify-items-center
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px; justify-items: center\"><div>a</div><div>bb</div></div>"}

 {:id :grid/align-items-center-in-a-tall-row
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 80px; grid-template-rows: 60px; align-items: center\"><div>mid</div></div>"}

 {:id :grid/separate-row-and-column-gap
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 60px 60px; row-gap: 24px; column-gap: 8px\"><div>a</div><div>b</div><div>c</div><div>d</div></div>"}

 {:id :grid/inline-grid-in-a-sentence
  :group :grid
  :html "<p>before <span style=\"display: inline-grid; grid-template-columns: 30px 30px\"><span>a</span><span>b</span></span> after</p>"}

 {:id :grid/auto-columns-size-to-content
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: auto auto; width: 400px\"><div>short</div><div>a much longer cell</div></div>"}

 ;; --- overflow and scroll containers ------------------------------------

 {:id :overflow/scroll-container-reserves-a-scrollbar
  :group :overflow
  ;; A classic (non-overlay) scrollbar takes width away from the content
  ;; box, so the child of a 200px scroll container is NOT 200px wide.
  :html "<div style=\"overflow-y: scroll; width: 200px; height: 50px\"><div>child</div></div>"}

 {:id :overflow/x-hidden-y-scroll
  :group :overflow
  :html "<div style=\"overflow-x: hidden; overflow-y: scroll; width: 200px; height: 40px\"><p>alpha beta gamma delta epsilon</p></div>"}

 {:id :overflow/child-taller-than-a-clipped-parent
  :group :overflow
  ;; Clipping does not resize either box: the parent stays 30, the child
  ;; still reports 80.
  :html "<div style=\"overflow: hidden; height: 30px; width: 150px\"><div style=\"height: 80px\">tall child</div></div>"}

 {:id :overflow/nested-scroll-containers
  :group :overflow
  :html "<div style=\"overflow: auto; width: 200px; height: 80px\"><div style=\"overflow: auto; width: 120px; height: 40px\"><p>alpha beta gamma</p></div></div>"}

 ;; --- percentages, auto margins and clamping ----------------------------

 {:id :box/percentage-width
  :group :box
  :html "<div style=\"width: 400px\"><div style=\"width: 50%\">half</div></div>"}

 {:id :box/percentage-height-of-a-fixed-parent
  :group :box
  :html "<div style=\"height: 100px; width: 120px\"><div style=\"height: 50%\">half</div></div>"}

 {:id :box/percentage-height-of-an-auto-parent
  :group :box
  ;; A percentage height against an `auto` height resolves to `auto`, not
  ;; to half of nothing.
  :html "<div style=\"width: 120px\"><div style=\"height: 50%\">auto</div></div>"}

 {:id :box/margin-auto-centers-a-block
  :group :box
  :html "<div style=\"width: 400px\"><div style=\"width: 100px; margin: 0 auto\">mid</div></div>"}

 {:id :box/negative-margin-pulls-up
  :group :box
  :html "<div><div>first</div><div style=\"margin-top: -8px\">pulled</div></div>"}

 {:id :box/border-box-with-padding-and-border
  :group :box
  :html "<div style=\"box-sizing: border-box; width: 200px; padding: 10px; border: 4px solid #000\">bb</div>"}

 {:id :box/min-height-loses-to-content
  :group :box
  :html "<div style=\"min-height: 10px; width: 120px\"><p>alpha</p><p>beta</p></div>"}

 {:id :box/max-width-percentage
  :group :box
  :html "<div style=\"width: 300px\"><div style=\"max-width: 50%; width: 280px\">clamped</div></div>"}

 {:id :box/calc-width
  :group :box
  :html "<div style=\"width: 300px\"><div style=\"width: calc(100% - 40px)\">calc</div></div>"}

 {:id :box/calc-width-mixed-units
  :group :box
  ;; The other half of calc(): a percentage and a length ADDED, so a
  ;; resolver that quietly dropped the percentage term would still be
  ;; caught (260 and 160 are not the same wrong answer).
  :html "<div style=\"width: 300px\"><div style=\"width: calc(50% + 10px)\">calc</div></div>"}

 {:id :box/width-auto-with-side-margins
  :group :box
  ;; `width: auto` on a block absorbs the margins rather than overflowing.
  :html "<div style=\"width: 300px\"><div style=\"margin-left: 30px; margin-right: 50px\">fills</div></div>"}

 {:id :box/margin-left-auto-pushes-a-block-right
  :group :box
  ;; ONE auto margin takes all the leftover space, so the box ends up
  ;; against the far edge rather than centred.
  :html "<div style=\"width: 400px\"><div style=\"width: 100px; margin-left: auto\">right</div></div>"}

 {:id :box/margin-auto-with-a-vertical-length
  :group :box
  ;; The shorthand's vertical value must not leak into the `auto` inline
  ;; sides: 10px top and bottom, CENTRED left and right.
  :html "<div style=\"width: 400px\"><div style=\"width: 100px; margin: 10px auto\">mid</div></div>"}

 {:id :box/margin-right-auto-leaves-a-block-left
  :group :box
  ;; The mirror of box/margin-left-auto-pushes-a-block-right, and the one
  ;; that says a naive "any auto margin centres it" rule is wrong.
  :html "<div style=\"width: 400px\"><div style=\"width: 100px; margin-right: auto\">left</div></div>"}

 {:id :box/margin-auto-with-no-room-does-not-centre
  :group :box
  ;; Over-constrained: the declared width is WIDER than the containing
  ;; block, so there is nothing to share and both auto margins are 0.
  :html "<div style=\"width: 200px\"><div style=\"width: 300px; margin: 0 auto\">wide</div></div>"}

 {:id :box/negative-margin-left-widens-an-auto-width-block
  :group :box
  ;; A negative margin on an `auto` width block does not move it, it makes
  ;; it WIDER -- the width is what absorbs the margin.
  :html "<div style=\"width: 200px\"><div style=\"margin-left: -20px\">wide</div></div>"}

 {:id :box/negative-margin-bottom-pulls-the-next-sibling-up
  :group :box
  ;; The bottom-side twin of box/negative-margin-pulls-up: collapsing a
  ;; positive and a negative margin ADDS them, it does not take the larger.
  :html "<div><div style=\"margin-bottom: -8px\">first</div><div>second</div></div>"}

 {:id :box/percentage-height-of-a-padded-parent
  :group :box
  ;; Which basis a percentage height resolves against: the parent's CONTENT
  ;; height (100 here, padding excluded), not its border box.
  :html "<div style=\"height: 100px; padding: 10px; width: 120px\"><div style=\"height: 50%\">half</div></div>"}

 ;; --- text: direction, breaking, inherited line-height -------------------

 {:id :text/rtl-with-inline-elements
  :group :text
  :html "<p style=\"direction: rtl; width: 300px\">alpha <b>beta</b> gamma</p>"}

 {:id :text/rtl-two-inline-elements
  :group :text
  ;; The asymmetric counterpart of the case above, whose text either side
  ;; of its <b> happens to be the same width: here nothing is symmetric,
  ;; so a line that merely LOOKS right-placed cannot score. Measured in
  ;; Brave the five words sit at 159.45/180.45/221.58/270.58/286 against
  ;; the identical ltr markup's 0/21/62.13/111.13/126.55 -- the same
  ;; order, every one shifted by the same 159.45.
  :html "<p style=\"direction: rtl; width: 300px\">aa <b>bbbb</b> cccccc <i>d</i> ee</p>"}

 {:id :text/rtl-text-align-end-is-the-left-edge
  :group :text
  ;; `start`/`end` are direction-RELATIVE: in an rtl block `end` is the
  ;; LEFT edge, and Brave puts this <b> at x=42, exactly where the same
  ;; markup with no direction at all puts it.
  :html "<p style=\"direction: rtl; width: 300px; text-align: end\">alpha <b>beta</b> gamma</p>"}

 {:id :text/ltr-text-align-end-is-the-right-edge
  :group :text
  ;; ...and the other half of the same rule, which this engine also did
  ;; not have: in an ltr block `end` is the RIGHT edge. Brave: <b> at
  ;; 227.48.
  :html "<p style=\"direction: ltr; width: 300px; text-align: end\">alpha <b>beta</b> gamma</p>"}

 {:id :text/rtl-text-align-left-overrides-the-direction
  :group :text
  ;; A PHYSICAL `text-align` still means the physical thing it says. An
  ;; rtl block told `left` puts its line on the left (Brave: <b> at 42),
  ;; which is what keeps the rtl default from being a hardcoded edge.
  :html "<p style=\"direction: rtl; width: 300px; text-align: left\">alpha <b>beta</b> gamma</p>"}

 {:id :text/rtl-wraps-then-places-each-line
  :group :text
  ;; Breaking happens in logical order and EACH resulting line is placed
  ;; on its own -- not the paragraph placed once. Measured in Brave, line
  ;; one runs 33.17..160 and line two 62..160, two different offsets.
  :html "<p style=\"direction: rtl; width: 160px\">one two <b>three</b> four five six seven</p>"}

 {:id :text/rtl-br-sits-at-the-left-end-of-its-line
  :group :text
  ;; A <br>'s zero-width box is at the line's inline-END edge, which in an
  ;; rtl block is its LEFT. Brave reports it at x=279 on a line whose only
  ;; word runs 279..300.
  :html "<p style=\"direction: rtl; width: 300px\">aaa<br>bb cc</p>"}

 {:id :text/rtl-atomic-inline-keeps-its-place-in-the-line
  :group :text
  ;; An image among ltr words in an rtl block moves with the line and not
  ;; against it. Brave: aa at 238, the image at 259, bb at 286.
  :html "<p style=\"direction: rtl; width: 300px\">aa <img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" width=\"20\" height=\"10\"> bb</p>"}

 {:id :text/rtl-hebrew-reverses-the-words
  :group :text
  ;; The half a line's PLACEMENT cannot explain. Every word here is strong
  ;; right-to-left, so UAX #9 reverses them: Brave reads the third word
  ;; leftmost (\u05d0\u05d1\u05d2 at 193.58, \u05e2\u05d5\u05dc\u05dd at 225.78,
  ;; \u05e9\u05dc\u05d5\u05dd at 266.38). Right-placing the line without reordering it
  ;; would put them in exactly the wrong order.
  :html "<p style=\"direction: rtl; width: 300px\">שלום עולם אבג</p>"}

 {:id :text/rtl-hebrew-with-an-inline-element
  :group :text
  ;; The same reversal across an inline box boundary: the <b> is the
  ;; MIDDLE word and Brave reports it at x=227.52 with the first word to
  ;; its right.
  :html "<p style=\"direction: rtl; width: 300px\">שלום <b>עולם</b> אבג</p>"}

 {:id :text/rtl-hebrew-keeps-an-embedded-latin-run-in-order
  :group :text
  ;; A left-to-right run INSIDE reversed text keeps its own internal
  ;; order, which is UAX #9 L2's nested reversal and the reason the
  ;; algorithm is not just "reverse the line". Brave: \u05d0\u05d1\u05d2 at 178.17,
  ;; then `one` at 210.39 and `two` at 238.39 -- still one before two --
  ;; then \u05e9\u05dc\u05d5\u05dd at 266.39.
  :html "<p style=\"direction: rtl; width: 300px\">שלום one two אבג</p>"}

 {:id :text/ltr-hebrew-run-reverses-inside-a-latin-line
  :group :text
  ;; ...and the mirror image, which is why this is not an rtl-only branch:
  ;; an LTR paragraph reverses the rtl run inside it and leaves everything
  ;; else alone. Brave: alpha 0, \u05e2\u05d5\u05dc\u05dd 42, \u05e9\u05dc\u05d5\u05dd 82.59, beta 123.22
  ;; -- the two Hebrew words swapped, the two Latin ones did not move.
  :html "<p style=\"direction: ltr; width: 300px\">alpha שלום עולם beta</p>"}

 {:id :text/rtl-arabic-reverses-the-words
  :group :text
  ;; Arabic, to pin that the rtl character class is a class and not a
  ;; Hebrew special case. Brave: \u0623\u0647\u0644\u0627 at 176.78, \u0639\u0644\u064a\u0643\u0645 at 208.98,
  ;; \u0627\u0644\u0633\u0644\u0627\u0645 at 257.98.
  :html "<p style=\"direction: rtl; width: 300px\">السلام عليكم أهلا</p>"}

 {:id :text/rtl-mixed-direction-word-is-not-split
  :group :text
  ;; The boundary of what this engine resolves: a word is the smallest
  ;; thing that carries a direction here (see strong-rtl? in
  ;; cssom.layout), so a single word holding strong characters of BOTH
  ;; directions stays one run. Brave splits it INSIDE the word -- asked
  ;; directly, `getClientRects()` returns two rects for it, `abc` at
  ;; 213.19 and the Hebrew at 234.19, in that order.
  ;;
  ;; This case PASSES, and it is worth saying why rather than reading the
  ;; pass as agreement: the line axis cannot see the split. A multi-rect
  ;; word is re-grouped per character by TOP (see run.cljs's own comment
  ;; on why -- it exists for words broken across LINES), and both of
  ;; these rects share a top, so the oracle folds them back into one
  ;; entry carrying the whole word. The engine and the browser agree on
  ;; where the word sits among its neighbours and disagree only inside
  ;; it, which is exactly the documented cut and exactly the part this
  ;; harness has no axis for. Kept as the record of a boundary that is
  ;; real but currently unmeasurable here, not as evidence of correctness.
  :html "<p style=\"direction: rtl; width: 300px\">אבג שלוםabc דהו</p>"}

 {:id :text/rtl-block-alignment
  :group :text
  ;; In an rtl containing block a narrower block sits against the RIGHT
  ;; edge, because it is the `margin-right: auto` side that resolves.
  :html "<div style=\"direction: rtl; width: 200px\"><div style=\"width: 60px\">box</div></div>"}

 {:id :text/rtl-margin-right-auto-flips-the-block
  :group :text
  ;; An EXPLICIT auto margin still wins over the direction's own default
  ;; side, so this rtl block sits LEFT: it is the `margin-right: auto` that
  ;; resolves, not the `margin-left: 0`.
  :html "<div style=\"direction: rtl; width: 200px\"><div style=\"width: 60px; margin-right: auto\">box</div></div>"}

 {:id :text/rtl-block-with-an-auto-width-child
  :group :text
  ;; An `auto` width block fills its rtl containing block exactly as it
  ;; does an ltr one -- there is no leftover space for the direction to
  ;; place, so nothing should move.
  :html "<div style=\"direction: rtl; width: 200px\"><div>fills</div></div>"}

 {:id :text/word-break-break-all
  :group :text
  :html "<div style=\"width: 90px; word-break: break-all\">abcdefghijklmnopqrstuvwxyz</div>"}

 {:id :text/tab-in-pre
  :group :text
  :html "<pre>a\tb</pre>"}

 {:id :text/unitless-line-height-inherits-the-factor
  :group :text
  ;; A UNITLESS line-height inherits the NUMBER, so the 24px child gets
  ;; 36px...
  :html "<div style=\"line-height: 1.5\"><p style=\"font-size: 24px\">big</p></div>"}

 {:id :text/em-line-height-inherits-the-computed-value
  :group :text
  ;; ...while an `em` line-height inherits the RESOLVED length, so the same
  ;; child gets 21px (1.5 x the PARENT's 14px). The pair isolates one rule.
  :html "<div style=\"line-height: 1.5em\"><p style=\"font-size: 24px\">big</p></div>"}

 {:id :text/font-size-em-chain
  :group :text
  :html "<div style=\"font-size: 1.5em\"><div style=\"font-size: 1.5em\">nested</div></div>"}

 {:id :text/negative-text-indent
  :group :text
  :html "<p style=\"width: 200px; text-indent: -20px; padding-left: 20px\">alpha beta gamma delta</p>"}

 ;; --- display types the corpus never exercised --------------------------

 {:id :display/table-cells-from-divs
  :group :display
  :html "<div style=\"display: table; width: 300px\"><div style=\"display: table-row\"><div style=\"display: table-cell\">a</div><div style=\"display: table-cell\">bb</div></div></div>"}

 {:id :display/table-with-anonymous-rows
  :group :display
  ;; Two `table-cell` children of a `table` with no row between them: CSS
  ;; generates the anonymous row box.
  :html "<div style=\"display: table; width: 200px\"><div style=\"display: table-cell\">a</div><div style=\"display: table-cell\">b</div></div>"}

 {:id :display/contents-is-transparent
  :group :display
  ;; `display: contents` generates NO box of its own -- the browser reports
  ;; a 0x0 rect for it -- and its children become the flex items.
  ;; ONE of this case's four boxes is not comparable by construction: an
  ;; empty `getBoundingClientRect` is 0,0,0,0 in VIEWPORT coordinates, so
  ;; once the harness subtracts the case root's offset it reads as a large
  ;; negative y that depends on where the case sits on the page. The other
  ;; three carry the signal.
  :html "<div style=\"display: flex; width: 300px\"><div style=\"display: contents\"><div>a</div><div>b</div></div></div>"}

 {:id :display/list-item-on-a-div
  :group :display
  ;; :oracle/blind -- the generated marker is not DOM text, so no Range can
  ;; reach it while this engine synthesizes it as real text. Geometry and
  ;; computed style are still scored.
  :oracle/blind true
  :html "<div style=\"display: list-item; margin-left: 20px\">item</div>"}

 {:id :display/flow-root-establishes-a-context
  :group :display
