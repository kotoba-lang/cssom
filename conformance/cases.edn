 ;; --- display types the corpus never exercised --------------------------

 {:id :display/table-cells-from-divs
  :group :display
  :html "<div style=\"display: table; width: 300px\"><div style=\"display: table-row\"><div style=\"display: table-cell\">a</div><div style=\"display: table-cell\">bb</div></div></div>"}

 {:id :display/table-with-anonymous-rows
  :group :display
  ;; Two `table-cell` children of a `table` with no row between them: CSS
  ;; generates the anonymous row box.
  :html "<div style=\"display: table; width: 200px\"><div style=\"display: table-cell\">a</div><div style=\"display: table-cell\">b</div></div>"}

 {:id :display/contents-is-transparent
  :group :display
  ;; `display: contents` generates NO box of its own -- the browser reports
  ;; a 0x0 rect for it -- and its children become the flex items.
  ;; ONE of this case's four boxes is not comparable by construction: an
  ;; empty `getBoundingClientRect` is 0,0,0,0 in VIEWPORT coordinates, so
  ;; once the harness subtracts the case root's offset it reads as a large
  ;; negative y that depends on where the case sits on the page. The other
  ;; three carry the signal.
  :html "<div style=\"display: flex; width: 300px\"><div style=\"display: contents\"><div>a</div><div>b</div></div></div>"}

 {:id :display/list-item-on-a-div
  :group :display
  ;; :oracle/blind -- the generated marker is not DOM text, so no Range can
  ;; reach it while this engine synthesizes it as real text. Geometry and
  ;; computed style are still scored.
  :oracle/blind true
  :html "<div style=\"display: list-item; margin-left: 20px\">item</div>"}

 {:id :display/flow-root-establishes-a-context
  :group :display
  ;; `display: flow-root` is what `overflow: hidden` gets used for without
  ;; the clipping: it contains the float AND stops the first child's margin
  ;; collapsing through the parent.
  :html "<div style=\"display: flow-root; width: 200px\"><div style=\"float: left; width: 50px; height: 60px\">F</div><p>text</p></div>"}

