 ;; --- grid track sizing and item alignment ------------------------------
 ;;
 ;; The corpus already had a case per FLOW gap (auto-flow-column,
 ;; auto-rows, the gap longhands); these are the sizing and alignment rules
 ;; those cases depend on but never isolate, so a regression in one of them
 ;; would have shown up only as a mystery in a composite case.

 {:id :grid/auto-track-overflows-a-narrow-grid
  :group :grid
  ;; An `auto` track's floor is its items' MIN-content size, so two of them
  ;; holding 41.6px and 50.1px of unbreakable word overflow a 60px grid
  ;; rather than crushing to 30px each.
  :html "<div style=\"display: grid; grid-template-columns: auto auto; width: 60px\"><div>short</div><div>a much longer cell</div></div>"}

 {:id :grid/auto-track-beside-an-fr
  :group :grid
  ;; With an `fr` track competing for the leftover space, the `auto` track
  ;; stops at its own max-content instead of stretching -- the opposite of
  ;; what it does in :grid/auto-columns-size-to-content.
  :html "<div style=\"display: grid; grid-template-columns: auto 1fr; width: 400px\"><div>short</div><div>x</div></div>"}

 {:id :grid/auto-track-beside-a-fixed-one
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: auto 100px; width: 400px\"><div>short</div><div>x</div></div>"}

 {:id :grid/justify-items-end
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px; justify-items: end\"><div>a</div><div>bb</div></div>"}

 {:id :grid/justify-self-overrides-justify-items
  :group :grid
  ;; The item with `justify-self` shrinks and centres; its sibling keeps
  ;; the container's stretch and stays a full track wide.
  :html "<div style=\"display: grid; grid-template-columns: 120px 120px\"><div style=\"justify-self: center\">a</div><div>bb</div></div>"}

 {:id :grid/align-items-end
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 80px; grid-template-rows: 60px; align-items: end\"><div>mid</div></div>"}

 {:id :grid/align-self-in-a-tall-row
  :group :grid
  :html "<div style=\"display: grid; grid-template-columns: 80px; grid-template-rows: 60px\"><div style=\"align-self: center\">mid</div></div>"}

 {:id :grid/auto-flow-column-fills-rows-first
  :group :grid
  ;; Two explicit rows and five items: the flow fills a COLUMN top to
  ;; bottom before moving right, so the third item starts a new column.
  :html "<div style=\"display: grid; grid-auto-flow: column; grid-template-rows: 30px 30px; grid-auto-columns: 70px\"><div>a</div><div>b</div><div>c</div><div>d</div><div>e</div></div>"}

 {:id :grid/auto-flow-column-past-the-template
  :group :grid
  ;; Column flow creates IMPLICIT columns beyond grid-template-columns;
  ;; with no grid-auto-columns they are `auto`.
