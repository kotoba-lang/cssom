 ;; ---- tables, deeper ----

 {:id :table/with-caption
  :group :table
  :html "<table><caption>Caption text</caption><tr><td>a</td><td>b</td></tr></table>"}

 {:id :table/nested-table
  :group :table
  :html "<table><tr><td><table><tr><td>inner</td></tr></table></td><td>outer</td></tr></table>"}

