  :html "<div style=\"display: grid; grid-template-columns: repeat(3, 160px); gap: 12px\"><div><h3>Free</h3><p>0 yen</p></div><div><h3>Pro</h3><p>1000 yen</p></div><div><h3>Team</h3><p>5000 yen</p></div></div>"}

 {:id :page/comment-thread
