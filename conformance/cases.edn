  :group :table
  :html "<table><tr><td rowspan=\"2\">tall</td><td>a</td></tr><tr><td>b</td></tr></table>"}

 {:id :table/cells-with-explicit-width
  :group :table
  :html "<table><tr><td style=\"width: 120px\">wide</td><td>rest</td></tr></table>"}

 {:id :table/empty-cells
  :group :table
  :html "<table><tr><td>a</td><td></td><td>c</td></tr></table>"}

